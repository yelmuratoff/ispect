{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "includeCoAuthoredBy": false,
    "permissions": {
        "defaultMode": "default",
        "allow": [
            "Bash(git status)",
            "Bash(git status --short)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git blame *)",
            "Bash(rg *)",
            "Bash(find *)",
            "Bash(ls *)",
            "Bash(sed *)",
            "Bash(dart pub get)",
            "Bash(dart analyze *)",
            "Bash(dart test *)",
            "Bash(dart format *)",
            "Bash(flutter pub get)",
            "Bash(flutter analyze *)",
            "Bash(flutter test *)",
            "Bash(flutter build web *)",
            "Bash(dart run tool/bin/ispect_tool.dart version check)",
            "Bash(dart run tool/bin/ispect_tool.dart deps)",
            "Bash(dart run tool/bin/ispect_tool.dart readme *)",
            "Bash(dart run tool/bin/ispect_tool.dart llms *)",
            "Bash(dart run tool/bin/ispect_tool.dart changelog *)",
            "Bash(dart run tool/bin/ispect_tool.dart sync --dry-run)",
            "Bash(dart run tool/bin/ispect_tool.dart release-prep *)",
            "Bash(dart run tool/bin/ispect_tool.dart check-published)",
            "Bash(dart run tool/bin/ispect_tool.dart publish --dry-run)",
            "Read",
            "Write",
            "Edit"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(git rebase *)",
            "Bash(git reset *)",
            "Bash(dart run tool/bin/ispect_tool.dart sync *)",
            "Bash(dart run tool/bin/ispect_tool.dart version bump *)",
            "Bash(dart run tool/bin/ispect_tool.dart publish --auto)",
            "Bash(flutter build apk *)",
            "Bash(flutter build appbundle *)",
            "Bash(flutter build ipa *)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(gh secret *)",
            "Read(.env)",
            "Read(.env.*)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/secrets/**)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/id_rsa*)",
            "Read(**/google-services.json)",
            "Read(**/GoogleService-Info.plist)"
        ]
    }
}
